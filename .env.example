# ==============================================================================
# MySirati Environment Configuration Template
# Copy this file to .env on your deployment server or local development environment.
# Never commit the actual .env file to version control.
# ==============================================================================

# PostgreSQL database connection credentials
POSTGRES_USER=mysirati_user
POSTGRES_PASSWORD=replace_with_a_secure_database_password
POSTGRES_DB=mysirati_db

# Complete PostgreSQL connection string used by backend and Drizzle ORM
# Inside Docker network, the db host is 'db' on default port 5432
DATABASE_URL=postgres://mysirati_user:replace_with_a_secure_database_password@db:5432/mysirati_db

# Secret key used for signing session cookies (minimum 32 random characters)
SESSION_SECRET=replace_with_a_long_random_session_secret_min_32_chars


# Initial administrator account credentials seeded via CLI command
ADMIN_EMAIL=admin@mysirati.local
ADMIN_PASSWORD=replace_with_a_secure_admin_password

# Public canonical URL of the application (used for constructing share links and CORS/origin verification)
PUBLIC_BASE_URL=https://mysirati.example.com

# Optional host port mapping for local frontend testing (default 8090)
# Note: Host ports 80, 3000, 5050, 5432, 5678, 5679, 8080 and 9443 are reserved on the production server.
FRONTEND_PORT=8090
